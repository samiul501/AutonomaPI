CORS_ORIGINS=http://localhost:3000
REQUEST_TIMEOUT_SECONDS=15
MAX_NEGATIVE_CASES_PER_ENDPOINT=50

# Optional: enables Gemini-elaborated, endpoint-specific adversarial test cases
# (see app/agent/llm_case_generator.py) instead of the fixed heuristic fuzz set.
# Free key, no card required: https://aistudio.google.com/app/apikey
# Never used to transmit raw tokens/PII — app/agent/masking.py scrubs everything first.
# Without this set, the heuristic PayloadGenerator is used for every endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
